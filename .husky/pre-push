#!/bin/sh

# Load nvm so node is available
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use 20 >/dev/null 2>&1

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't push directly to main - please check out a branch."
  exit 1
fi

# Ensure local binaries are available
export PATH="$PWD/node_modules/.bin:$PATH"

# Run type checks
pnpm run check-types

# Run tests (if enabled)
if [ -f ".env.local" ]; then
  if ./node_modules/.bin/dotenvx get RUN_TESTS_ON_PUSH -f .env.local 2>/dev/null | grep -q "^true$"; then
    ./node_modules/.bin/dotenvx run -f .env.local -- pnpm run test
  fi
else
  if [ "$RUN_TESTS_ON_PUSH" = "true" ]; then
    pnpm run test
  fi
fi

# Check for changesets
NEW_CHANGESETS=$(find .changeset -name "*.md" ! -name "README.md" | wc -l | tr -d ' ')
echo "Changeset files: $NEW_CHANGESETS"

if [ "$NEW_CHANGESETS" = "0" ]; then
  echo "-------------------------------------------------------------------------------------"
  echo "Changes detected. Please run 'pnpm changeset' to create a changeset if applicable."
  echo "-------------------------------------------------------------------------------------"
fi